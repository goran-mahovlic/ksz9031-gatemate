## ULX5M-GS (CCGM1A1) + KSZ9031RNX — 1000 Mb/s RGMII, top gbe_top
## Pins and pad options as in the LiteX 1G design that pings on this board at 1000FD
## (litex-eth-ulx5m-gs-1g, gateware/target_gbe.py eth_io, tag gbe-1000m-ping-ok-20260925).
## IO_EB_A3 (KSZ9031 XI from the FPGA) is deliberately absent: XI comes from X1.

Net "clk_25mhz"   Loc = "IO_SB_A8" | SCHMITT_TRIGGER=true;

## RGMII TX: TXD/TX_CTL are CC_ODDR (IOSEL DDR) on gtx, TXC = PLL CLK90 through CC_BUFG (no FF)
Net "eth_tx_clk"  Loc = "IO_EB_B2" | SLEW=fast | DRIVE=6;
Net "eth_tx_ctl"  Loc = "IO_EB_A2" | SLEW=fast | DRIVE=6;
Net "eth_txd[0]"  Loc = "IO_EB_B5" | SLEW=fast | DRIVE=6;
Net "eth_txd[1]"  Loc = "IO_EB_A5" | SLEW=fast | DRIVE=6;
Net "eth_txd[2]"  Loc = "IO_EB_B4" | SLEW=fast | DRIVE=6;
Net "eth_txd[3]"  Loc = "IO_EB_A4" | SLEW=fast | DRIVE=6;

## RGMII RX
Net "eth_rx_clk"  Loc = "IO_EB_A7";
Net "eth_rx_ctl"  Loc = "IO_EB_A8";
Net "eth_rxd[0]"  Loc = "IO_EB_A0";
Net "eth_rxd[1]"  Loc = "IO_EB_B0";
Net "eth_rxd[2]"  Loc = "IO_EB_A1";
Net "eth_rxd[3]"  Loc = "IO_EB_B1";

## PHY control
Net "eth_rst_n"   Loc = "IO_EB_B3" | SLEW=slow | DRIVE=3;
Net "eth_mdc"     Loc = "IO_EB_B6";
Net "eth_mdio"    Loc = "IO_EB_A6" | PULLUP=true;

## UART over the DirtyJTAG bridge (GPIO5 TX / GPIO4 RX)
Net "uart_tx"     Loc = "IO_NB_B5";
Net "uart_tx_alt" Loc = "IO_NA_A4";
Net "uart_rx"     Loc = "IO_NA_B6" | PULLUP=true;

## LEDs (active high)
Net "led[0]" Loc = "IO_SB_A0" | DRIVE=3;
Net "led[1]" Loc = "IO_SB_B0" | DRIVE=3;
Net "led[2]" Loc = "IO_SB_A1" | DRIVE=3;
Net "led[3]" Loc = "IO_SB_B1" | DRIVE=3;
Net "led[4]" Loc = "IO_SB_B2" | DRIVE=3;
Net "led[5]" Loc = "IO_SB_A2" | DRIVE=3;
Net "led[6]" Loc = "IO_SB_B3" | DRIVE=3;
Net "led[7]" Loc = "IO_SB_A3" | DRIVE=3;
