## iobuf_test custom CCF — try alternate UART RX pin
## TX known good on IO_NA_A4 (phase5 confirmed). RX pin under investigation.
Net "clk_25mhz" Loc = "IO_SB_A8" | SCHMITT_TRIGGER=true;

Net "btn[0]" Loc = "IO_EA_B4";
Net "btn[1]" Loc = "IO_EA_A4";
Net "btn[2]" Loc = "IO_EA_B3";

Net "led[0]" Loc = "IO_SB_A0";
Net "led[1]" Loc = "IO_SB_B0";
Net "led[2]" Loc = "IO_SB_A1";
Net "led[3]" Loc = "IO_SB_B1";
Net "led[4]" Loc = "IO_SB_B2";
Net "led[5]" Loc = "IO_SB_A2";
Net "led[6]" Loc = "IO_SB_B3";
Net "led[7]" Loc = "IO_SB_A3";

Net "uart_tx" Loc = "IO_NA_A4" | SLEW=fast;
## RX candidates:  IO_NA_B4 (current), IO_NA_B6 (v02), IO_NA_A5, IO_NB_A4, IO_NB_B4
Net "uart_rx" Loc = "IO_NA_B6" | SCHMITT_TRIGGER=true;

## Ethernet pads (kept inert, but mapped to satisfy top-level signature)
Net "eth_rst_n"  Loc = "IO_EB_B7";
Net "eth_mdc"    Loc = "IO_EB_B6";
Net "eth_mdio"   Loc = "IO_EB_A6" | PULLUP=true | SLEW=fast;
Net "eth_tx_clk" Loc = "IO_EB_A0";
Net "eth_txd[0]" Loc = "IO_EB_B0";
Net "eth_txd[1]" Loc = "IO_EB_A1";
Net "eth_txd[2]" Loc = "IO_EB_B1";
Net "eth_txd[3]" Loc = "IO_EB_A2";
Net "eth_tx_ctl" Loc = "IO_EB_B2";
Net "eth_rx_clk" Loc = "IO_EB_A3";
Net "eth_rxd[0]" Loc = "IO_EB_B3";
Net "eth_rxd[1]" Loc = "IO_EB_A4";
Net "eth_rxd[2]" Loc = "IO_EB_B4";
Net "eth_rxd[3]" Loc = "IO_EB_A5";
Net "eth_rx_ctl" Loc = "IO_EB_B5";
