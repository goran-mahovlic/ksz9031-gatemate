# Lab connection settings for flash.sh / test.sh
#
# Copy to scripts/lab.env and fill in your own values:
#     cp scripts/lab.env.example scripts/lab.env
#
# scripts/lab.env is git-ignored on purpose: it describes YOUR private network,
# which must never end up in a public repository.
# Every value can also be supplied as an environment variable, which takes
# precedence over this file.

# SSH target of the host that has the JTAG dongle attached (user@host).
RPI_HOST="fpga@raspberrypi.local"

# Directory on that host where the bitstream is copied to.
RPI_DIR="/home/fpga/FPGA"

# IP address the FPGA design answers on, and its MAC address.
FPGA_IP="192.168.1.150"
FPGA_MAC="10:e2:d5:00:00:00"

# Host used by test.sh, if it differs from the JTAG host above.
# Leave unset to reuse RPI_HOST.
#TEST_RPI_HOST="fpga@raspberrypi.local"
